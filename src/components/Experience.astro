---
import type { Lang } from "../i18n/i18n";
import { t, i18nText } from "../i18n/i18n";
import { experience } from "../data/experience";
import Section from "./Section.astro";
import ExperienceItem from "./ExperienceItem.astro";
import TechFilterBar from "./TechFilterBar.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Section
  id="experiencia"
  lang={lang}
  tagKey="sections.experienceTag"
  titleKey="sections.experienceTitle"
>
  <TechFilterBar lang={lang} scope="experience" total={experience.length} />
  <div class="timeline">
    {
      experience.map((entry, i) => (
        <ExperienceItem entry={entry} lang={lang} stagger={(i % 7) + 1} />
      ))
    }
  </div>
  <p
    class="filter-empty"
    data-filter-empty
    hidden
    {...i18nText("filter.empty")}
  >
    {t("filter.empty", lang)}
  </p>
</Section>

<style>
  .timeline {
    position: relative;
  }
</style>
